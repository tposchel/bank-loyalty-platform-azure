{
  "AzureAdB2C": {
    "Instance": "https://{B2C_DOMAIN}/",
    "Domain": "{B2C_DOMAIN}",
    "TenantId": "{B2C_TENANT_ID}",
    "ClientId": "{B2C_API_CLIENT_ID}",
    "SignUpSignInPolicyId": "{B2C_SIGNIN_POLICY}"
  },
  "ReverseProxy": {
    "Routes": [
      { "RouteId": "tenants", "ClusterId": "tenants", "Match": { "Path": "/api/tenants/{**catch-all}" } },
      { "RouteId": "customers", "ClusterId": "customers", "Match": { "Path": "/api/customers/{**catch-all}" } }
    ],
    "Clusters": {
      "tenants": { "Destinations": { "d1": { "Address": "http://tenantmanagement:8080/" } } },
      "customers": { "Destinations": { "d1": { "Address": "http://customer:8080/" } } }
    }
  }
}
